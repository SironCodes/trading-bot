# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Paper keys: Alpaca dashboard -> Paper account -> API Keys.
ALPACA_PAPER_KEY=your-paper-key-id
ALPACA_PAPER_SECRET=your-paper-secret
# Live keys are read only when live trading is fully unlocked (see README). Leave empty.
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
# paper (default) or live
TRADING_ENV=paper
